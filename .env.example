# Copiar a .env y completar con valores reales

# Conexión a Postgres (en desarrollo local apunta al contenedor db expuesto en 5433)
DATABASE_URL=postgres://bazar:bazar@localhost:5433/bazar

# Clave inicial para entrar al panel /admin (obligatoria). Después se cambia
# desde el panel (Ajustes → Clave del panel) y esta deja de valer. Si se
# olvida la nueva, `npm run admin:reset` vuelve a esta.
ADMIN_PASSWORD=

# Secreto largo y aleatorio para firmar la sesión del admin (obligatorio,
# mínimo 32 caracteres). Generarlo con:  openssl rand -hex 32
SESSION_SECRET=

# Carpeta donde se guardan las fotos subidas (opcional, por defecto ./uploads)
# UPLOAD_DIR=./uploads

# URL pública del sitio, para la vista previa al compartir el link (opcional:
# si falta, se deduce de cada pedido). Ej: https://catalogo.ejemplo.com
# SITE_URL=
